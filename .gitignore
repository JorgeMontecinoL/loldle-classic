__pycache__/
*.pyc
.DS_Store
.venv/
.venv-ft/
.ipynb_checkpoints/

# Datos de entrenamiento: se regeneran idénticos con finetune/make_data.py (semilla fija).
finetune/data/**/*.jsonl
# Adaptadores: se versiona sólo el final (finetune/adapters/final/); las rondas
# y alternativas se regeneran con sus configuraciones en finetune/.
finetune/adapters/*
!finetune/adapters/final/
# Logs de los servidores de modelo de la demo.
results/d2/server_logs/
# Grabaciones del video (se suben aparte, con enlace abierto).
video/
# Logs locales del servidor del Entregable 3.
results/d3/server_logs/
# Adaptadores del D3: el multirol (v3) y el seleccionado (v4); no los intermedios ni sus puntos de control.
!finetune/adapters/d3_multirol/
finetune/adapters/d3_multirol/0*_adapters.safetensors
!finetune/adapters/d3_paginas_cot3/
finetune/adapters/d3_paginas_cot3/0*_adapters.safetensors
